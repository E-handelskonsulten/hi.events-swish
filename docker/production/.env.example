# Production environment for the Biljettera stack (docker/production/docker-compose.yml).
# Copy to /srv/biljettera/.env on the server and fill in the values there. Never commit the filled-in file.
# Every secret is generated on the server; the container refuses to start with the example values (see docs/DEPLOYMENT_RUNBOOK.md).

# --- Hosts and TLS ---
ADMIN_HOST=admin.biljettera.se
PUBLIC_HOST=demo.biljettera.se
ACME_EMAIL=

# --- Application ---
APP_NAME=Biljettera
APP_ENV=production
APP_DEBUG=false
APP_URL=https://demo.biljettera.se
APP_FRONTEND_URL=https://demo.biljettera.se
APP_CDN_URL=https://demo.biljettera.se/storage
APP_LOCALE=se
APP_KEY=                                  # echo base64:$(openssl rand -base64 32)
JWT_SECRET=                               # openssl rand -base64 48
APP_DISABLE_REGISTRATION=false
APP_SAAS_MODE_ENABLED=false
APP_PLATFORM_SUPPORT_EMAIL=support@biljettera.se
APP_ALERTS_EMAIL=                         # receives flagged Swish payments and failed refunds
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local
API_DOCS_ENABLED=false

# --- Frontend (read at runtime by the SSR server) ---
VITE_APP_NAME=Biljettera
VITE_DEFAULT_LOCALE=se
VITE_FRONTEND_URL=https://demo.biljettera.se
VITE_API_URL_CLIENT=/api
VITE_API_URL_SERVER=http://localhost:80/api
VITE_APP_LOGO_LIGHT=/images/biljettera/logo-light.png
VITE_APP_LOGO_DARK=/images/biljettera/logo-dark.png
VITE_APP_FAVICON=/images/biljettera/favicon-32.png
VITE_PLATFORM_SUPPORT_EMAIL=support@biljettera.se
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Database ---
POSTGRES_DB=hievents
POSTGRES_USER=hievents
POSTGRES_PASSWORD=                        # openssl rand -hex 24
DATABASE_URL=postgresql://hievents:<POSTGRES_PASSWORD>@postgres:5432/hievents

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                           # openssl rand -hex 24

# --- Mail (Resend over SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=resend
MAIL_PASSWORD=                            # Resend API key (re_...)
MAIL_FROM_ADDRESS=no-reply@biljettera.se
MAIL_FROM_NAME=Biljettera

# --- Swish ---
SWISH_ENABLED=true
SWISH_ENVIRONMENT=mss                     # mss until the production certificates arrive
SWISH_PAYEE_ALIAS=1234679304
SWISH_CERT_PATH=/etc/hievents/swish/Swish_Merchant_TestCertificate_1234679304.pem
SWISH_KEY_PATH=/etc/hievents/swish/Swish_Merchant_TestCertificate_1234679304.key
SWISH_KEY_PASSPHRASE=
SWISH_CA_PATH=/etc/hievents/swish/Swish_TLS_RootCA.pem
SWISH_CALLBACK_BASE_URL=https://demo.biljettera.se/api

# --- Stripe (unused for now) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
GEO_PROVIDER=
GOOGLE_MAPS_API_KEY=
