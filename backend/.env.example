APP_NAME=Hi.Events
# Default language for new accounts, buyers without a language cookie and system e-mails.
# Supported codes: en, de, fr, it, nl, hu, es, pt, pt-br, zh-cn, se (Swedish), zh-hk, vi, tr, pl, sk, el
APP_LOCALE=se
APP_ENV=local
APP_KEY=base64:DwMidgIu8YVSEg0BLMrh5JS2dk1POpCn3rvDaZk3fEQ=
APP_DEBUG=true
APP_LOG_QUERIES=false
APP_URL=http://localhost
APP_PORT=1234
APP_FRONTEND_URL=https://localhost:8443
APP_CDN_URL=http://localhost:9000/hievents-public
APP_SAAS_MODE_ENABLED=false
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=1.5
APP_HOMEPAGE_VIEWS_UPDATE_BATCH_SIZE=8
APP_DISABLE_REGISTRATION=false
APP_STRIPE_CONNECT_ACCOUNT_TYPE=express
APP_PLATFORM_SUPPORT_EMAIL=support@your-website.com
APP_ALLOWED_INTERNAL_WEBHOOK_HOSTS=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CORS_ALLOWED_ORIGINS=*

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=backend
DB_USERNAME=username
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_PUBLIC_DISK=s3-public
FILESYSTEM_PRIVATE_DISK=s3-private
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_AUTO_TLS=true
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=app
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_PUBLIC_BUCKET=hievents-public
AWS_PRIVATE_BUCKET=hievents-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

JWT_SECRET=2hoccgHb9r1fqW1lU16C6khSHVa7O0eai6FxkWK95UtQ0LqNDTO5mq1RzDwcq18I
JWT_ALGO=HS256

# Google Places address autocomplete. Geo features are disabled until an API key is set.
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# Only required for SAAS mode and if your're charging fees
# OPEN_EXCHANGE_RATES_APP_ID=

# Swish (installation-wide fallback; per-organizer settings in the admin UI take precedence)
SWISH_ENABLED=false
SWISH_ENVIRONMENT=mss
SWISH_PAYEE_ALIAS=
SWISH_CERT_PATH=
SWISH_KEY_PATH=
SWISH_KEY_PASSPHRASE=
SWISH_CA_PATH=

SMS_ENABLED=false
SMS_DEFAULT_SENDER=Biljettera
SMS_DRY_RUN=false
ELKS_USERNAME=
ELKS_PASSWORD=

BILLING_SUMMARY_EMAIL=
BILLING_DEFAULT_PLATFORM_FEE_PER_TICKET=6.00
BILLING_DEFAULT_SMS_FEE_PER_MESSAGE=0.50
# Public base URL Swish posts callbacks to (must be HTTPS and include the /api prefix when served behind nginx)
SWISH_CALLBACK_BASE_URL=
